# Modello delle variabili da impostare nell’ambiente prima di avviare il backend.
# Non contiene credenziali reali e non viene caricato automaticamente da Spring Boot.
# JWT_SECRET deve essere una chiave casuale di almeno 32 byte codificata in Base64.
DB_URL=jdbc:postgresql://localhost:5432/nutritional_expert
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-password
JWT_SECRET=replace-with-base64-encoded-random-secret-at-least-32-bytes
